# Plantilla de variables de entorno de UNA región (contenedor de la aplicación).
# Copiar al gestor de secretos del despliegue, nunca al repositorio con valores.
# Un despliegue = una región = su propia base, usuarios y secretos.
# Marcas: [requerida] | [condicional: cuándo] | [opcional]. Ver deploy/regiones/README.md.

# --- 1. Región -----------------------------------------------------------------
# [requerida] Id de config/regiones/<REGION>.json y de REGISTRO en
# lib/infraestructura/region/registro.ts. Vacía o ausente = corrientes.
# Un id desconocido o un JSON inválido aborta el arranque (instrumentation.ts).
REGION=

# --- 2. Base de datos (propia de este despliegue) ------------------------------
# [requerida] Postgres de esta región. El nombre de la base decide el rol si
# RIESGO_DATOS_ROL no está seteada (lib/infraestructura/riesgo/providers/rol-entorno.ts).
DATABASE_URL=
# [condicional: base con TLS] "require" activa SSL (lib/db/config-postgres.ts).
DATABASE_SSL=
# [condicional: TLS con CA propia] ruta al certificado dentro del contenedor.
DATABASE_SSL_CA_PATH=

# --- 3. Acceso y primer administrador ------------------------------------------
# [requerida] URL pública https de la aplicación de esta región (lib/auth.ts, lib/public-origin.ts).
BETTER_AUTH_URL=
# [condicional: base vacía, sólo la primera vez] Siembra el primer administrador
# (lib/db/seed.ts). Quitarlas después del primer arranque.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- 4. Rol y fuentes de datos -------------------------------------------------
# [requerida, explícita recomendada] productor = consulta APIs (Open-Meteo, INA,
# Prefectura). consumidor = replica desde hub_prod (scripts/replicar-*.mjs).
RIESGO_DATOS_ROL=productor
# [condicional: productor, jobs Open-Meteo] SECRETO. Plan B11.6.
OPEN_METEO_API_KEY=
# [condicional: sync-imerg y climatologia-imerg] SECRETO. Sin él, nasa-imerg queda no_disponible.
EARTHDATA_TOKEN=
# [condicional: consumidor] URL de la base de origen y de la réplica (sólo lectura del origen).
# RIESGO_SOURCE_DATABASE_URL=
# RADAR_SOURCE_DATABASE_URL=
# PREFECTURA_SOURCE_DATABASE_URL=
# HAZARD_SOURCE_DATABASE_URL=

# --- 5. Veredicto con IA ------------------------------------------------------
# [opcional] false = el veredicto no llama a la IA.
AI_VEREDICTO_ENABLED=false
# [condicional: AI_VEREDICTO_ENABLED=true] SECRETO. AI_API_KEY tiene precedencia si se setea
# (lib/infraestructura/briefing-ia/proveedor-openrouter.ts).
OPENROUTER_API_KEY=
# [opcional] modelo del veredicto; sin valor rige el default del código.
OPENROUTER_MODEL=

# --- 6. Interruptores operativos -----------------------------------------------
# Valores de referencia del despliegue de producción (docs/ejecucion-enos/OPS1/runbook-scheduler.md).
# Confirmarlos por región antes de encender la aplicación.
ENOS_JOBS_ENABLED=true
RISK_RADAR_ENABLED=true
RISK_ENGINE_ENABLED=true
HAZARD_CONTEXT_ENABLED=true
SITUACION_ENABLED=true
SEASONAL_ENABLED=false
RISK_MODE=shadow

# --- 7. Específica de Corrientes ------------------------------------------------
# [sólo despliegue de Corrientes] URL https de la card externa del hub. Vacía = no-op
# (lib/infraestructura/recurso-seed.ts). No setear en Manaos.
ENOS_MANAOS_URL=

# --- 8. Adjuntos y materiales en almacenamiento S3 -----------------------------
# [condicional: MATERIALES_STORAGE=s3] Sin esto, los materiales quedan en DATA_DIR (/data).
MATERIALES_STORAGE=
OBS_BUCKET=
OBS_REGION=
OBS_ENDPOINT=
# SECRETO (credencial de acceso al bucket).
OBS_ACCESS_KEY_ID=
# SECRETO.
OBS_SECRET_ACCESS_KEY=
# [opcional] true para endpoints que exigen path-style.
OBS_FORCE_PATH_STYLE=

# --- 9. Secretos de funciones concretas ----------------------------------------
# [condicional: funciones nominales] SECRETO. Base64 de exactamente 32 bytes (AES-256),
# generada por región; no reutilizar entre regiones (lib/infraestructura/identidad-cripto.ts).
NOMINAL_ENCRYPTION_KEY=
# [condicional: importación de matrícula] SECRETO. No rotar sin reimportar los cortes
# (lib/infraestructura/matricula/dni.ts).
MATRICULA_DNI_SECRET=
# [condicional: exportación desidentificada] SECRETO. Sal local del hash
# (lib/infraestructura/dataset/export-desidentificado.ts).
DATASET_SALT_E7B=

# --- 10. Operación (opcional) --------------------------------------------------
# [opcional] Nivel de log de la aplicación.
LOG_LEVEL=info
# [opcional] Escuelas y estaciones del testigo de la sonda; sin setear rige el default del código.
SONDA_ESCUELAS_TESTIGO=
SONDA_ESTACIONES_TESTIGO=

# --- No setear en producción -----------------------------------------------------
# ENOS_REGION_CONFIG_DIR (sólo pruebas), DATABASE_URL_TEST, PGLITE_DATA_DIR,
# GE_SSO_* (reenvío de staging de Corrientes), CUADERNILLOS_PG_*, DEMO_OK.
# DATA_DIR y APP_REVISION ya vienen de la imagen (Dockerfile).
