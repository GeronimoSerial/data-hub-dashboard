[Unit]
Description=Timer OPS1 ENOS: climatologia-caudal (mensual, cursor resumable de cupo)

[Timer]
# Corrida mensual en horario de baja carga; el cursor resumable conserva
# el avance entre ejecuciones y evita repetir celdas ya persistidas.
OnCalendar=*-*-01 06:40:00 UTC
RandomizedDelaySec=300
Persistent=true
Unit=enos-ops1@climatologia-caudal.service

[Install]
WantedBy=timers.target
