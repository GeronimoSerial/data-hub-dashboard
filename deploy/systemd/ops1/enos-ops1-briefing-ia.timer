[Unit]
Description=Timer OPS1 ENOS: briefing-ia (cada hora, 10 minutos despues de situacion-corte)

[Timer]
# Offset de 10min respecto a situacion-corte (que corre a :20) para que el
# briefing narrativo asistido por IA lea un corte del Centro de Situación ya
# persistido (E8) y no arranque antes de que exista la materia prima.
#
# CAVEAT DE SECUENCIA (ver runbook): el offset es fijo, así que si el timer de
# situacion-corte se atrasa, el briefing puede leer un corte de la hora previa
# (o quedarse sin corte y devolver 'sin_corte_disponible'). Ver "Caveat de
# secuencia entre jobs distintos" en el runbook.
OnCalendar=*-*-* *:30:00 UTC
RandomizedDelaySec=60
Persistent=true
Unit=enos-ops1@briefing-ia.service

[Install]
WantedBy=timers.target
