[Unit]
Description=Job OPS1 ENOS: %i
After=docker.service

[Service]
Type=oneshot
# Archivo opcional de entorno del host: contiene el prefijo estable de Coolify
# y permite reenviar ENOS_JOBS_ENABLED como interruptor operativo.
EnvironmentFile=-/etc/enos-ops1/enos-ops1.env
# El wrapper resuelve el nombre dinámico del contenedor en cada ejecución.
ExecStart=/usr/local/bin/enos-ops1-exec %i
# Límites defensivos: un job colgado o con fuga de memoria no debe tumbar el
# host. Ajustar si algún job real necesita más al medir en el ensayo local.
MemoryMax=512M
TimeoutStartSec=600
