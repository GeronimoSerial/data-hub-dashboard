BETTER_AUTH_SECRET=replace-with-32+chars
BETTER_AUTH_URL=http://localhost:3000
# Better Auth requires a domain with a dot.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme-admin
DATA_DIR=.data

# Cifrado AES-256-GCM del alcance nominal (lib/infraestructura/identidad.ts).
# 32 bytes en base64, p.ej.: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Nunca en la base ni en el repositorio. Ver docs/rotacion-clave-nominal.md
# para el procedimiento de rotación y qué hacer si se pierde.
NOMINAL_ENCRYPTION_KEY=

# "Explícame este recurso" — optional AI provider (OpenAI-compatible).
# Without AI_API_KEY the CTA degrades to a safe, configured unavailable state.
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1
# AI_TIMEOUT_MS=20000

# Padrón nominal: base Postgres de Gestión Educativa. La leen SOLO los scripts
# de mantenimiento (scripts/import-padron.mjs --ge), nunca el servidor.
# Formato URL recomendado; también se acepta el de pares clave/valor de .NET
# (Server=...;Port=...;Database=...;User Id=...;Password=...).
# PADRON_PG_URL=postgres://usuario:clave@host:5432/asistencias
