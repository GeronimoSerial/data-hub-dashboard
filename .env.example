BETTER_AUTH_SECRET=replace-with-32+chars
BETTER_AUTH_URL=http://localhost:3000
# Better Auth requires a domain with a dot.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme-admin
DATA_DIR=.data

# Cifrado AES-256-GCM del alcance nominal (lib/infraestructura/identidad.ts).
# 32 bytes en base64, p.ej.: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Nunca en la base ni en el repositorio. Ver docs/rotacion-clave-nominal.md
# para el procedimiento de rotación y qué hacer si se pierde.
NOMINAL_ENCRYPTION_KEY=

# Contraseña temporal de acceso al formulario público de problemáticas y sus
# rutas API (lib/infraestructura/acceso-publico.ts). Provisoria: la reemplaza
# una autenticación por token más adelante. Nunca en logs, nunca hardcodeada.
PROBLEMATICAS_ACCESO_PASSWORD=

# Proveedor OpenAI-compatible para la acción «Explícame este recurso».
# Sin AI_API_KEY y OPENAI_API_KEY, la función queda no disponible sin hacer llamadas.
# AI_API_KEY=
# OPENAI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1
# AI_TIMEOUT_MS=20000

# Padrón nominal: base Postgres de Gestión Educativa. La leen SOLO los scripts
# de mantenimiento (scripts/import-padron.mjs --ge), nunca el servidor.
# Formato URL recomendado; también se acepta el de pares clave/valor de .NET
# (Server=...;Port=...;Database=...;User Id=...;Password=...). También se
# acepta la variable heredada ConnectionStrings como alternativa.
PADRON_PG_URL=

# Base principal del hub (lib/db). Una URL postgres:// o postgresql:// habilita
# el driver postgres; sin ella se usa PGlite embebido (tests/desarrollo local).
DATABASE_URL=postgres://usuario:password@localhost:5432/enos_hub

# SSL de la conexión. 'false' apagado, 'true'/'1' TLS validando, 'require' TLS
# sin validar CA (típico contra RDS). PGSSLMODE=require fuerza lo mismo;
# DATABASE_SSL_CA_PATH valida contra un CA propio (falla si el archivo no existe).
DATABASE_SSL=false
PGSSLMODE=
DATABASE_SSL_CA_PATH=

# Pool de conexiones y timeouts (milisegundos). DATABASE_POOL_MAX sin setear usa
# el default de pg (10); los otros tres ya traen default explícito.
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=10000
DATABASE_POOL_CONNECT_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=30000

# Flags del producto y del scheduler (apagados por defecto; se activan por entorno).
# Las banderas booleanas requieren exactamente "true". RISK_MODE acepta shadow
# (predeterminado seguro) o advisory; cualquier otro valor se trata como shadow.
# RISK_ENGINE_ENABLED=false
# RISK_RADAR_ENABLED=false
# Piloto activado por defecto; sólo el valor literal "false" lo desactiva.
# RADAR_ENSEMBLE_ENABLED=true
# AI_BRIEFING_ENABLED=false
# HAZARD_CONTEXT_ENABLED=false
# SEASONAL_ENABLED=false
# SITUACION_ENABLED=false
# EPISODIOS_DERIVADOS_ENABLED=false
# RISK_MODE=shadow
# ENOS_JOBS_ENABLED=true

# Persistencia PGlite opcional (sin DATABASE_URL se usa DATA_DIR/pg).
# PGLITE_DATA_DIR=

# Jobs e importadores.
# GEO_STATIC_OUTPUT_DIR=services/geo-static/output
# Sal para seudonimizar el CUE en el export desidentificado (obligatoria para ese script).
# DATASET_SALT_E7B=

# Proveedores externos: claves requeridas solo por el job que las usa.
# No incluir secretos en el repositorio.
# OPEN_METEO_API_KEY=
# OPEN_METEO_LIMITE_HOURLY=
# OPEN_METEO_LIMITE_DAILY=
# OPEN_METEO_LIMITE_MONTHLY=
# OPEN_METEO_LIMITE_HOURLY_PAGO=
# OPEN_METEO_LIMITE_DAILY_PAGO=
# OPEN_METEO_LIMITE_MONTHLY_PAGO=
# EARTHDATA_TOKEN=
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# E8_PRESUPUESTO_USD_MES=5
# E8_COSTO_MAXIMO_USD_LLAMADA=0.01

# Private Huawei OBS bucket used for report photo uploads.
# OBS_BUCKET=
# OBS_REGION=
# OBS_ENDPOINT=
# OBS_ACCESS_KEY_ID=
# OBS_SECRET_ACCESS_KEY=
# OBS_FORCE_PATH_STYLE=false
# Offline reports rollout flags. Enable with the exact value "true".
# REPORTES_OFFLINE_BORRADORES_SYNC=
# REPORTES_OFFLINE_FOTOS=
# REPORTES_OFFLINE_MAPA_BORRADORES=

# Datasets de infraestructura: todos los datos del mapa se leen de la DB.
# Jobs Python: ruta a Node 24+ cuando no esté en PATH.
GEO_STATIC_NODE_BINARY=
# Exportaciones de diagnóstico opcionales; el flujo normal publica en DB.
GEO_STATIC_EXPORT_FILES=0
# Réplica entre entornos: inyectar estas conexiones fuera del repositorio.
SOURCE_DATABASE_URL=
TARGET_DATABASE_URL=
# Sólo staging: conexión de origen para consumir la cola de Prefectura.
PREFECTURA_SOURCE_DATABASE_URL=

# Radar: sólo producción consulta Open-Meteo. En staging/dev configurar false.
# RADAR_SYNC_ENABLED=false
# Réplica sin API (origen hub_prod; DATABASE_URL debe apuntar a hub_staging o hub_dev).
# RADAR_SOURCE_DATABASE_URL=postgresql://usuario:clave@host/hub_prod
